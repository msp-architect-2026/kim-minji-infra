{
  "uid": "wafer-slo",
  "title": "Wafer SLO",
  "tags": [
    "slo",
    "wafer"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "panels": [
    {
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "id": 1,
      "options": {
        "mode": "markdown",
        "content": "**SLO** — 가용성 99.5%, backend p95 < 1초, AI(/predict) p95 < 3초 (목표 기간 30일). 대시보드 기간 안의 달성률을 보여 준다. Prometheus 보존 기간(dev 2일 / full 7일)보다 긴 기간은 계산되지 않는다. 오류 예산 소진 속도 1 = 30일에 예산을 정확히 다 쓰는 속도"
      }
    },
    {
      "type": "stat",
      "title": "backend 가용성 (기간 내 달성률)",
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "1 - avg_over_time(slo:sli_error:ratio_rate1h{slo=\"backend-availability\"}[$__range])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.995
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "type": "stat",
      "title": "backend 지연 p95<1s (기간 내 달성률)",
