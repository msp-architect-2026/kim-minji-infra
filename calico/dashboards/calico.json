{
  "uid": "calico",
  "title": "Calico CNI",
  "tags": [
    "calico",
    "network"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "panels": [
    {
      "type": "stat",
      "title": "calico-node 준비",
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(kube_pod_status_ready{namespace=\"calico-system\",pod=~\"calico-node-.*\",condition=\"true\"})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Felix 동기화 완료 노드",
      "id": 2,
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "count(felix_resync_state == 3)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "iptables 적용 오류 (1h)",
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(felix_iptables_restore_errors[1h])) or vector(0)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "IP 풀 사용률",
      "id": 4,
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(ipam_allocations_in_use) / sum(ipam_ippool_size)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "노드별 활성 엔드포인트(Pod)",
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "felix_active_local_endpoints",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "노드별 IPAM 할당",
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (node) (ipam_allocations_in_use)",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "데이터플레인 적용 시간 (p90)",
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max by (node) (felix_int_dataplane_apply_time_seconds{quantile=\"0.9\"})",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "iptables 오류·재동기화",
      "id": 8,
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (node) (rate(felix_iptables_restore_errors[5m]))",
          "legendFormat": "restore err {{node}}",
          "refId": "A"
        },
        {
          "expr": "sum by (node) (rate(felix_resyncs_started[5m]))",
          "legendFormat": "resync {{node}}",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "calico-node CPU",
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"calico-system\",container=\"calico-node\"}[5m]))",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "calico-node 메모리",
      "id": 10,
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"calico-system\",container=\"calico-node\"})",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    }
  ]
}
